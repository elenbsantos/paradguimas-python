total_deducoes = valor_previdencia + valor_pensao + deducao_dependentes

base_calculo = salario_bruto - valor_previdencia - valor_pensao - deducao_dependentes

if total_deducoes > salario_bruto:
    print('As deduções são maiores que o salário bruto.')

else:
    if base_calculo <= 2500:
        aliquota = 0

    elif base_calculo > 2500 and base_calculo <= 3500:
        aliquota = 0.075

    elif base_calculo > 3500 and base_calculo <= 5000:
        aliquota = 0.15

