# 1-Caixa eletrônico com saldo e tentativas
senha_correta = '9539'
saldo = 0
tentativas = 0

quantidade_saques = 0
quantidade_deposito = 0
total_depositado = 0
total_sacado = 0

while tentativas < 3:
    senha = input('Digite sua senha: ')

    if senha == senha_correta:
        print('senha correta')
        break

    else:
        tentativas = tentativas + 1

if tentativas == 3:
    print('\nacesso bloqueado')

opcao = 0

while opcao != 5:
    print('\nOPCÕES')
    print('1-consultar saldo')
    print('2-depositar')
    print('3-sacar')
    print('4-exibir quantidade de operações')
    print('5-encerrar')

    opcao= int(input('escolha uma opção:'))

    if opcao == 1:
        print('\nsaldo:',saldo)

    elif opcao == 2:
        deposito = float(input('informe o valor do deposito: '))

        if deposito > 0:
            saldo = saldo + deposito
            quantidade_deposito = quantidade_deposito + 1
            total_depositado = total_depositado + deposito

        else:
            print('deposito invalido')

    elif opcao == 3:
        saque = float(input('informe o valor do saque: '))

        if saque > 0 and saque <= saldo:
            saldo = saldo - saque
            quantidade_saques = quantidade_saques + 1
            total_sacado = total_sacado + saque

        else:
            print('saque invalido')

    elif opcao == 4:
        print('quantidade de depositos:',quantidade_deposito)
        print('quantidade de saques:', quantidade_saques)

    elif opcao == 5:
        print('Operação encerrada')

else:
        print('opção invalida')

print('\nRELATÓRIO')
print('saldo final:', saldo)
print('quantidade de depositos:', quantidade_deposito)
print('quantidade de saques:', quantidade_saques)
print('total depositado:', total_depositado)
print('total sacado:', total_sacado)



# 2-Jogo de adivinhação com níveis
numero_secreto = 46
nivel = input('escolha o nivel (facil,medio ou dificil):')
tentativas = 0
tentativas_usadas = 0
numero_digitado = 0
acertou = False

if nivel == 'facil':
    tentativas = 10

elif nivel == 'medio':
    tentativas = 7

elif nivel == 'dificil':
    tentativas = 5

while tentativas > 0:
    numero_digitado = int(input('digite um número de 1 a 100: '))

    if numero_digitado < 1 or numero_digitado > 100:
        print('numero invalido')
        continue

    tentativas = tentativas - 1
    tentativas_usadas = tentativas_usadas + 1

    if numero_digitado == numero_secreto:
        print('você acertou!')
        acertou = True


    elif numero_digitado > numero_secreto:
        print('o numero digitado é maior que o numero secreto')

    else:
        print('o numero digitado é menor que o numero secreto')

    print('\ntentativas restantes:', tentativas)

    if acertou:
        break

if acertou:
    print('vitoria!')

else:
    print('derrota!')

print('tentativas usadas:', tentativas_usadas)

pontuacao = tentativas * 100
print('pontuação:', pontuacao)



# 3-Controle de estoque por menu
estoque = 100
estoque_inicial = 100
estoque_minimo = 0

quantidade_entradas = 0
quantidade_saidas = 0

total_entradas = 0
total_saidas = 0

opcao = 0

while opcao != 5:
    print('        MENU ')
    print('1-Entrada de mercadoria')
    print('2-Saida de mercadoria')
    print('3-Consultar estoque')
    print('4-Definir estoque minimo')
    print('5-Encerrar')

    opcao = int(input('escolha uma opção:'))

    if opcao == 1:
        entrada = int(input('digite a quantidade de mercadorias que entrou:'))

        if entrada > 0:
            estoque = estoque + entrada
            quantidade_entradas = quantidade_entradas + 1
            total_entradas = total_entradas + entrada
            print('\nentrada realizada')

        else:
            print('entrada invalida')

    elif opcao == 2:
        saida = int(input('quantas mercadorias você deseja retirar:'))

        if saida > 0 and saida <= estoque:
            estoque = estoque - saida
            quantidade_saidas = quantidade_saidas + 1
            total_saidas = total_saidas + saida
            print('\nsaida realizada')

            if estoque < estoque_minimo:
                print('ALERTA: O estoque esta abaixo do minimo')

        else:
            print('saida invalida')

    elif opcao == 3:
        print('estoque atual: ', estoque)
        print('estoque minimo: ', estoque_minimo)

    elif opcao == 4:
        estoque_minimo = int(input('defina o estoque minimo: '))

        if estoque_minimo >= 0:
            print('estoque minimo definido')

        else:
            print('valor invalido')

    elif opcao == 5:
        print('operação encerrada')

    else:
        print('opção invalida')

    quantidade_operacoes = quantidade_entradas + quantidade_saidas

    if estoque < estoque_minimo:
        situacao = 'estoque abaixo do minimo'

    else:
        situacao = 'estoque adequado'

    print('\nestoque inicial:', estoque_inicial)
    print('total entradas:', total_entradas)
    print('total saidas:', total_saidas)
    print('estoque final:', estoque)
    print('quantidade de operações:', quantidade_operacoes)
    print('situacao do estoque:', situacao)