# 4-Simulação de financiamento
valor_financiado = float(input('informe o valor financiado:'))
taxa_mensal = float(input('informe a taxa mensal (%):'))
parcela_maxima = float(input('informe o valor da parcela maxima:'))
limite_meses = int(input('informe o limite maximo de meses:'))

saldo = valor_financiado
meses = 0
total_pago = 0
total_juros = 0
resultado = 0

while saldo > 0 and meses < limite_meses:
    juros = saldo * (taxa_mensal / 100)
    saldo = saldo + juros
    total_juros = total_juros + juros

    if parcela_maxima <= juros:
        print('a parcela não é o suficiente para reduzir a divida')
        resultado = 'financiamento não quitado'
        break

    if parcela_maxima >= saldo:
        total_pago = total_pago + saldo
        saldo = 0
    else:
        saldo = saldo - parcela_maxima
        total_pago = total_pago + parcela_maxima

    meses = meses + 1

    print('saldo restante: ', saldo)

    if saldo == 0:
        resultado = 'Financiamento quitado'

    elif meses == limite_meses:
        resultado = 'Financiamento não quitado'

print('total de meses: ', meses)
print('total pago: ', total_pago)
print('total de juros: ', total_juros)
print('saldo restante: ', saldo)
print('resultado da simulação: ', resultado)



