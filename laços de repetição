# 6-Relatório de desempenho de turma
quantidade_alunos = int(input('Quantidade de alunos: '))

aluno = 1
aprovados = 0
recuperacao = 0
reprovados = 0
soma_medias = 0

maior_media = 0
menor_media = 10
melhor_aluno = ''
aluno_menor_media = ''

while aluno <= quantidade_alunos:
    nome = input('\ndigite o nome do aluno: ')
    nota_1 = int(input('digite a nota 1: '))
    nota_2 = int(input('digite a nota 2: '))
    nota_3 = int(input('digite a nota 3: '))
    frequencia = float(input('digite a frequencia do aluno: '))

    media = (nota_1 + nota_2 + nota_3) / 3

    soma_medias = soma_medias + media

    if media >= 7 and frequencia >= 75:
        situacao = 'aprovado'

    elif media >= 5 and media < 7 and frequencia >= 75:
        situacao = 'recuperação'

    else:
        situacao = 'reprovado'

    if situacao == 'aprovado':
        aprovados = aprovados + 1

    elif situacao == 'recuperação':
        recuperacao = recuperacao + 1

    else:
        reprovados = reprovados + 1

    print('Aluno:', nome)
    print('Média:', media)
    print('Situação:', situacao)

    if media > maior_media:
        maior_media = media
        melhor_aluno = nome

    if media < menor_media:
        menor_media = media
        aluno_menor_media = nome

    aluno = aluno + 1

media_geral = soma_medias / quantidade_alunos
percentual_aprovacao = aprovados / quantidade_alunos * 100

print('\nRELATORIO FINAL')
print('media geral:', media_geral)
print('maior media:', maior_media)
print('melhor aluno:', melhor_aluno)
print('menor media:', menor_media)
print('aluno com menor media:', aluno_menor_media)
print('quantidade aprovados:', aprovados)
print('quantidade recuperação:', recuperacao)
print('quantidade reprovados:', reprovados)
print('percentual de aprovação:', percentual_aprovacao, '%')