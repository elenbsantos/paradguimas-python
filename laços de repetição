    valor = int(input('digite um número: '))

    if primeiro:
        maior = valor
        menor = valor
        primeiro = False

    soma = soma + valor

    if valor > 0:
        positivos = positivos + 1

    elif valor < 0:
        negativos = negativos + 1

    else:
        zeros = zeros + 1

    if valor % 2 == 0:
        pares = pares + 1

    else:
        impares = impares + 1

    if valor > maior:
        maior = valor

    if valor < menor:
        menor = valor

    numero = numero + 1

media = soma / quantidade_numeros

percentual_positivos = positivos / quantidade_numeros * 100
percentual_pares = pares / quantidade_numeros * 100

print('\nRESULTADO')
print('maior valor: ', maior)
print('menor valor: ', menor)
